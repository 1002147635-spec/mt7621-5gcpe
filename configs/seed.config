#
# OpenWrt 23.05 构建种子配置
# 用法：cat configs/seed.config >> .config && make defconfig
# 未识别的 CONFIG_PACKAGE_* 会被 defconfig 静默丢弃，属于预期行为
#

# ---- 目标平台 ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_mycpe_5gcpe=y
CONFIG_TARGET_MULTI_PROFILE=n

# ---- 基础系统 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_libustream-mbedtls=y

# ---- 5G 模组驱动栈（USB / M.2 模式）----
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y

# ---- 移远模组图形化管理（qmodem feed，装不上会自动跳过）----
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-app-qmodem-mwan=y
CONFIG_PACKAGE_quectel-CM=y

# ---- 网络增强 ----
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---- 镜像类型 ----
# INITRAMFS 必须为 y：首次烧录靠内存启动（initramfs-kernel.bin）再由 sysupgrade
# 自己写 NAND，绕开 U-Boot 裸写跳过坏块导致的镜像错位。关掉就没有这个文件。
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n

# ---- 体积控制 ----
# 注意：KERNEL_PARTSIZE 只对支持改内核分区的目标（x86 等）有效，
# ramips 下会被 defconfig 丢弃；ramips 的内核分区大小由 DTS + KERNEL_SIZE 决定。
CONFIG_TARGET_KERNEL_PARTSIZE=6
