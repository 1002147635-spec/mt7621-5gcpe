#!/bin/sh /etc/rc.common
#
# /etc/init.d/5g-watchdog —— 由 procd 托管，进程挂了会自动拉起
#

START=99
STOP=10
USE_PROCD=1

start_service() {
	local iface interval soft hard

	config_load 5gcpe
	config_get iface  main iface    "wwan"
	config_get interval main interval 20
	config_get soft   main soft_fail 3
	config_get hard   main hard_fail 9

	procd_open_instance
	procd_set_param command /usr/sbin/5g-watchdog
	procd_set_param env IFACE="$iface" INTERVAL="$interval" \
		SOFT_FAIL="$soft" HARD_FAIL="$hard"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
